#!/bin/bash
#
# agentic-researcher: Launch an AI coding agent in a sandboxed container.
# Usage: agentic-researcher [OPTIONS] [DIRECTORY] [TOOL_OPTIONS...]
# Run with --help for details.
#
# v2 architecture: there is no custom container image. Containers start from a
# stock base image (node:24-bookworm by default) and all tools are installed
# at runtime into a persistent store (AR_STATE_ROOT, mounted at /ar-store).
# The container is ephemeral; the store is the system of record.
#

set -e
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ -L "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$SCRIPT_PATH")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
USER=${USER:-$(whoami)}

# Container-side paths (single source of truth for tool bin directories)
STORE_MOUNT="/ar-store"
AR_TOOL_PATHS="$STORE_MOUNT/nodejs/bin:$STORE_MOUNT/home/.local/bin:$STORE_MOUNT/juliaup/bin:$STORE_MOUNT/bun/bin:$STORE_MOUNT/uv/bin:$STORE_MOUNT/npm-global/bin:$STORE_MOUNT/bin"
SYSTEM_PATHS="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
DEFAULT_IMAGE="node:24-bookworm"
DEFAULT_GPU_IMAGE="nvidia/cuda:13.1.1-cudnn-devel-ubuntu22.04"

# ============================================================================
# Configuration (config file + env overrides + defaults)
# ============================================================================

AR_CONFIG_VARS=(
    AR_CONTAINER_RUNTIME
    AR_CLI_TOOL
    AR_DEFAULT_MODEL
    AR_STATE_ROOT
    AR_EXTRA_ENV
    AR_DOCKER_GPUS
    AR_AUTH_MODE
    AR_API_PROVIDER
    AR_API_KEY_ENV
    AR_CUSTOM_ENDPOINT
    AR_CUSTOM_ANTHROPIC_ENDPOINT
    AR_HTTPS_PROXY
    AR_HTTP_PROXY
    AR_IMAGE
    AR_GPU_IMAGE
    AR_UPDATE
    AR_UPDATE_TTL
    AR_NO_COOLDOWN
    AR_UNSAFE
    AR_LOCKDOWN
    AR_EPHEMERAL
)

capture_env_overrides() {
    local var override_var unset_marker="__AR_UNSET__"
    for var in "${AR_CONFIG_VARS[@]}"; do
        override_var="${var}_ENV_OVERRIDE"
        if [[ -n "${!var+x}" ]]; then
            printf -v "$override_var" '%s' "${!var}"
        else
            printf -v "$override_var" '%s' "$unset_marker"
        fi
    done
}

config_file_path() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/agentic-researcher/config.sh"
}

load_config() {
    local cfg
    cfg="$(config_file_path)"
    if [[ -f "$cfg" ]]; then
        source "$cfg"
    fi
}

# Environment variables override config file values
apply_env_overrides() {
    local var override_var
    for var in "${AR_CONFIG_VARS[@]}"; do
        override_var="${var}_ENV_OVERRIDE"
        if [[ "${!override_var:-__AR_UNSET__}" != "__AR_UNSET__" ]]; then
            printf -v "$var" '%s' "${!override_var}"
        fi
    done

    if [[ -n "${AR_CONTAINER_RUNTIME_OVERRIDE:-}" ]]; then
        AR_CONTAINER_RUNTIME="$AR_CONTAINER_RUNTIME_OVERRIDE"
    fi
    if [[ -n "${AR_CLI_TOOL_OVERRIDE:-}" ]]; then
        AR_CLI_TOOL="$AR_CLI_TOOL_OVERRIDE"
    fi
    if [[ -n "${AR_DEFAULT_MODEL_OVERRIDE:-}" ]]; then
        AR_DEFAULT_MODEL="$AR_DEFAULT_MODEL_OVERRIDE"
    fi
}

check_install_staleness() {
    local marker="$SCRIPT_DIR/.agentic-researcher-install"
    [[ -f "$marker" ]] || return 0

    local source_path="" install_commit=""
    while IFS='=' read -r key value; do
        case "$key" in
            source_path) source_path="$value" ;;
            install_commit) install_commit="$value" ;;
        esac
    done < "$marker"

    [[ -n "$source_path" && -n "$install_commit" && -d "$source_path/.git" ]] || return 0

    local current_commit
    current_commit="$(git -C "$source_path" rev-parse HEAD 2>/dev/null)" || return 0

    if [[ "$install_commit" != "$current_commit" ]]; then
        echo "Warning: installed version is outdated (source repo has newer commits)."
        echo "  Run: $source_path/scripts/install.sh --force"
        echo ""
    fi
}

detect_default_oci_runtime() {
    if command -v docker >/dev/null 2>&1; then
        printf '%s\n' "docker"
    elif command -v podman >/dev/null 2>&1; then
        printf '%s\n' "podman"
    else
        printf '%s\n' "docker"
    fi
}

apply_defaults() {
    if [[ -z "${AR_CONTAINER_RUNTIME:-}" ]]; then
        AR_CONTAINER_RUNTIME="$(detect_default_oci_runtime)"
        if [[ "$AR_CONTAINER_RUNTIME" == "podman" ]] && ! command -v docker >/dev/null 2>&1; then
            echo "Docker not found, falling back to Podman."
        fi
    fi
    AR_CLI_TOOL="${AR_CLI_TOOL:-claude}"
    AR_STATE_ROOT="${AR_STATE_ROOT:-$HOME/.cache/agentic-researcher}"
    AR_EXTRA_ENV="${AR_EXTRA_ENV:-}"
    AR_DOCKER_GPUS="${AR_DOCKER_GPUS:-auto}"
    AR_IMAGE="${AR_IMAGE:-}"
    AR_GPU_IMAGE="${AR_GPU_IMAGE:-$DEFAULT_GPU_IMAGE}"
    AR_UPDATE="${AR_UPDATE:-auto}"
    AR_UPDATE_TTL="${AR_UPDATE_TTL:-}"
    AR_NO_COOLDOWN="${AR_NO_COOLDOWN:-}"
    AR_UNSAFE="${AR_UNSAFE:-0}"
    AR_LOCKDOWN="${AR_LOCKDOWN:-0}"
    AR_EPHEMERAL="${AR_EPHEMERAL:-0}"

    case "$AR_CLI_TOOL" in
        claude)
            AR_AUTH_MODE="${AR_AUTH_MODE:-oauth}"
            AR_API_PROVIDER="${AR_API_PROVIDER:-anthropic}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
            AR_DEFAULT_MODEL="${AR_DEFAULT_MODEL:-sonnet}"
            ;;
        opencode)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-OPENAI_API_KEY}"
            ;;
        gemini)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-GEMINI_API_KEY}"
            ;;
        codex)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-OPENAI_API_KEY}"
            ;;
        qwen)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-OPENAI_API_KEY}"
            ;;
        pi)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
            ;;
        bash)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-}"
            ;;
    esac
}

# ============================================================================
# Argument parsing
# ============================================================================

YOLO_MODE=false
TEST_MODE=false
PREWARM_MODE=false
PRINT_ENV_MODE=false
SHELL_MODE=false
SHELL_TARGET=""
DEBUG_LAUNCH=false
MODEL_SPECIFIED=false
WORKSPACE_DIR=""
TOOL_ARGS=()

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --setup)
                shift
                exec "$SCRIPT_DIR/scripts/first-setup.sh" "$@"
                ;;
            --build)
                # v2: no image build. --build prewarms the persistent store
                # (installs/updates all tools) without starting an agent.
                PREWARM_MODE=true
                shift
                ;;
            --clean)
                shift
                exec "$SCRIPT_DIR/scripts/cleanup.sh" "$@"
                ;;
            --uninstall)
                shift
                exec "$SCRIPT_DIR/scripts/uninstall.sh" "$@"
                ;;
            --test)
                TEST_MODE=true
                shift
                ;;
            --shell)
                SHELL_MODE=true
                if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
                    SHELL_TARGET="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --print-env)
                PRINT_ENV_MODE=true
                shift
                ;;
            --debug-launch)
                DEBUG_LAUNCH=true
                shift
                ;;
            --docker)
                AR_CONTAINER_RUNTIME_OVERRIDE="docker"
                shift
                ;;
            --podman)
                AR_CONTAINER_RUNTIME_OVERRIDE="podman"
                shift
                ;;
            --apptainer)
                echo "Error: the Apptainer runtime is not yet supported in v2."
                echo "See TODO.md - Apptainer/HPC support is planned on top of the"
                echo "persistent-store runtime. Use --docker or --podman for now."
                exit 1
                ;;
            --multi-node)
                echo "Error: --multi-node is not yet supported in v2 (it requires"
                echo "the Apptainer runtime). See TODO.md."
                exit 1
                ;;
            --ephemeral)
                AR_EPHEMERAL_ENV_OVERRIDE="1"
                shift
                ;;
            --unsafe)
                AR_UNSAFE_ENV_OVERRIDE="1"
                shift
                ;;
            --tool)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --tool requires a value (claude|opencode|gemini|codex|qwen|pi|bash)"
                    exit 1
                fi
                AR_CLI_TOOL_OVERRIDE="$2"
                shift 2
                ;;
            --yolo)
                YOLO_MODE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --resume|-r)
                if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
                    TOOL_ARGS+=("--resume" "$2")
                    shift 2
                else
                    TOOL_ARGS+=("--resume")
                    shift
                fi
                ;;
            --continue|-c)
                TOOL_ARGS+=("--continue")
                shift
                ;;
            --model)
                MODEL_SPECIFIED=true
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --model requires a value"
                    exit 1
                fi
                TOOL_ARGS+=("$1" "$2")
                shift 2
                ;;
            --context)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --context requires a value"
                    exit 1
                fi
                TOOL_ARGS+=("$1" "$2")
                shift 2
                ;;
            -*)
                TOOL_ARGS+=("$1")
                shift
                ;;
            *)
                if [[ -z "$WORKSPACE_DIR" ]]; then
                    WORKSPACE_DIR="$1"
                else
                    TOOL_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
}

show_help() {
    cat << 'EOF'
agentic-researcher: Launch an AI coding agent in a sandboxed container
                    for autonomous research.

Usage:
  agentic-researcher [OPTIONS] [DIRECTORY] [TOOL_OPTIONS...]

Options:
  --setup             Run the optional interactive setup wizard
  --build             Prewarm the persistent store (install/update all tools)
  --clean             Remove launcher-managed local state
  --uninstall         Remove the installed launcher and optional local state
  --docker            Force Docker runtime for this invocation
  --podman            Force Podman runtime for this invocation
  --test              Quick validation of sandbox environment
  --shell [NAME]      Open a shell in a running agentic-researcher container
  --print-env         Show the resolved configuration (secrets redacted)
  --debug-launch      Print extra launcher details and enable tool startup logs
  --tool TOOL         Select CLI tool (claude|opencode|gemini|codex|qwen|pi|bash)
  --yolo              Auto-approve all permissions (Claude Code only)
  --ephemeral         Use a throwaway store (removed when the session ends)
  --unsafe            Allow apt-get/system ops (agent runs as root)
  --resume [ID]       Resume a session (interactive picker, or specify ID)
  --continue, -c      Continue the most recent conversation
  --model MODEL       Override default model
  DIRECTORY           Project directory to work in (default: current directory)
  TOOL_OPTIONS        Additional options passed to the CLI tool

Examples:
  agentic-researcher --setup                      # Optional setup wizard
  agentic-researcher --build                      # Prewarm the tool store
  agentic-researcher                              # Current directory
  agentic-researcher ~/my-project                 # Specific directory
  agentic-researcher --yolo                       # Auto-approve (Claude)
  agentic-researcher --tool gemini                # Use Gemini CLI
  agentic-researcher --tool codex ~/project       # Use Codex CLI
  agentic-researcher --tool pi                    # Use pi
  agentic-researcher --tool bash                  # Plain shell in the sandbox
  agentic-researcher --yolo --model opus          # YOLO + Opus
  agentic-researcher --test                       # Validate environment
  agentic-researcher --shell                      # Shell into running container
  agentic-researcher --ephemeral --tool bash      # Throwaway store

Architecture:
  No image builds. Containers start from a stock base image; all CLI tools and
  runtimes are installed into a persistent store (AR_STATE_ROOT) on first run
  and updated automatically afterwards. The store survives container exits.

What's Sandboxed:
  The agent can ONLY access your project directory (/workspace) and the tool
  store. It cannot read your home directory, SSH keys, or other projects.
  Even with --yolo, the agent stays sandboxed.

Security:
  - Containers run with --cap-drop=ALL and no-new-privileges.
  - Package managers enforce a 7-day minimum release age (supply-chain
    cooldown); see AR_NO_COOLDOWN to exempt specific tools.
  - --yolo auto-approves tool calls but maintains filesystem isolation.
  - Review changes before committing to git.
EOF
}

# ============================================================================
# Validation
# ============================================================================

validate_workspace() {
    # Default to current directory
    if [[ -z "$WORKSPACE_DIR" ]]; then
        WORKSPACE_DIR="$(pwd)"
    fi

    # Resolve symlinks in a macOS/Linux portable way.
    if ! WORKSPACE_DIR="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$WORKSPACE_DIR" 2>/dev/null)"; then
        echo "Error: Cannot resolve path: $WORKSPACE_DIR"
        exit 1
    fi

    if [[ ! -d "$WORKSPACE_DIR" ]]; then
        echo "Error: Directory does not exist: $WORKSPACE_DIR"
        exit 1
    fi

    # SECURITY: Prevent sandboxing of sensitive system directories
    case "$WORKSPACE_DIR" in
        /|/etc/*|/etc|/root/*|/root|/sys/*|/sys|/proc/*|/proc|/dev/*|/dev|/boot/*|/boot)
            echo "Error: Cannot sandbox system directories: $WORKSPACE_DIR"
            exit 1
            ;;
        /home/*/.ssh/*|/home/*/.ssh|/Users/*/.ssh/*|/Users/*/.ssh)
            echo "Error: Cannot sandbox SSH directories: $WORKSPACE_DIR"
            exit 1
            ;;
        /home/*/.claude/*|/home/*/.claude|/Users/*/.claude/*|/Users/*/.claude)
            echo "Error: Cannot sandbox Claude config directories: $WORKSPACE_DIR"
            exit 1
            ;;
        /home/*/.gnupg/*|/home/*/.gnupg|/Users/*/.gnupg/*|/Users/*/.gnupg)
            echo "Error: Cannot sandbox GPG directories: $WORKSPACE_DIR"
            exit 1
            ;;
        /home/*/.aws/*|/home/*/.aws|/home/*/.kube/*|/home/*/.kube|/home/*/.config/gcloud/*|/home/*/.config/gcloud|/Users/*/.aws/*|/Users/*/.aws|/Users/*/.kube/*|/Users/*/.kube|/Users/*/.config/gcloud/*|/Users/*/.config/gcloud)
            echo "Error: Cannot sandbox cloud credential directories: $WORKSPACE_DIR"
            exit 1
            ;;
    esac
}

validate_api_key() {
    # Tool-managed auth and OAuth are handled inside the CLI itself.
    if [[ "$AR_CLI_TOOL" != "claude" || "${AR_AUTH_MODE:-tool}" == "tool" || "${AR_AUTH_MODE:-tool}" == "oauth" ]]; then
        return
    fi
    local key_var="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
    if [[ -z "${!key_var:-}" ]]; then
        echo "Error: $key_var environment variable is not set."
        echo ""
        echo "Either set your API key:"
        echo "  export $key_var='your-api-key-here'"
        echo ""
        echo "Or switch to OAuth login:"
        echo "  agentic-researcher --setup  (select 'oauth' for authentication)"
        exit 1
    fi
}

validate_runtime() {
    case "$AR_CONTAINER_RUNTIME" in
        docker|podman) ;;
        apptainer)
            echo "Error: the Apptainer runtime is not yet supported in v2 (see TODO.md)."
            echo "Set AR_CONTAINER_RUNTIME to docker or podman."
            exit 1
            ;;
        *)
            echo "Error: Unknown container runtime: $AR_CONTAINER_RUNTIME"
            exit 1
            ;;
    esac

    if ! command -v "$AR_CONTAINER_RUNTIME" >/dev/null 2>&1; then
        echo "Error: $AR_CONTAINER_RUNTIME runtime selected, but '$AR_CONTAINER_RUNTIME' is not installed or not on PATH."
        exit 1
    fi

    if ! "$AR_CONTAINER_RUNTIME" info >/dev/null 2>&1; then
        echo "Error: $AR_CONTAINER_RUNTIME is not running or not accessible."
        if [[ "$AR_CONTAINER_RUNTIME" == "docker" ]]; then
            echo "Try starting Docker (or Docker Desktop) first."
        fi
        exit 1
    fi
}

# ============================================================================
# Storage (persistent store)
# ============================================================================

EPHEMERAL_ACTIVE=false

cleanup_ephemeral_store() {
    if [[ "$EPHEMERAL_ACTIVE" == "true" && -n "${STATE_ROOT:-}" && -d "$STATE_ROOT" ]]; then
        case "$STATE_ROOT" in
            "${TMPDIR:-/tmp}"/agentic-researcher-store-*)
                rm -rf "$STATE_ROOT"
                echo "[agentic-researcher] Removed ephemeral store: $STATE_ROOT" >&2
                ;;
        esac
    fi
}

setup_storage() {
    if [[ "${AR_EPHEMERAL:-0}" == "1" ]]; then
        STATE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/agentic-researcher-store-XXXXXX")"
        EPHEMERAL_ACTIVE=true
        trap cleanup_ephemeral_store EXIT
    else
        STATE_ROOT="${AR_STATE_ROOT:-$HOME/.cache/agentic-researcher}"
    fi

    STORE_HOME="$STATE_ROOT/home"

    mkdir -p \
        "$STORE_HOME/.claude/commands" \
        "$STORE_HOME/.config/opencode/commands" \
        "$STORE_HOME/.pi/agent"
    chmod 700 "$STATE_ROOT" 2>/dev/null || true

    # Seed Claude onboarding bypass (first launch only; persists afterwards)
    if [[ ! -f "$STORE_HOME/.claude.json" ]]; then
        echo '{"hasCompletedOnboarding": true}' > "$STORE_HOME/.claude.json"
    fi

    # Copy (not mount) the host gitconfig: nested file binds inside an already
    # bind-mounted directory are not portable (Docker Desktop on macOS), and a
    # copy keeps the host file out of the agent's reach.
    if [[ -f "$HOME/.gitconfig" ]]; then
        cp -f "$HOME/.gitconfig" "$STORE_HOME/.gitconfig" 2>/dev/null || true
    fi
}

# ============================================================================
# Research assets (instruction file, commands, skills, endpoint templates)
# ============================================================================

render_instruction_template() {
    local output_path="$1"

    awk '
        /<!-- DOCKER-OMIT-START -->/ { skip=1; next }
        /<!-- DOCKER-OMIT-END -->/   { skip=0; next }
        !skip { print }
    ' "$SCRIPT_DIR/INSTRUCTIONS.md" > "$output_path"
}

setup_instruction_file() {
    # Map CLI tool to instruction file name in a Bash 3-compatible way.
    local target="CLAUDE.md"
    case "$AR_CLI_TOOL" in
        claude)
            target="CLAUDE.md"
            ;;
        opencode|codex|pi)
            target="AGENTS.md"
            ;;
        gemini)
            target="GEMINI.md"
            ;;
        qwen)
            target="QWEN.md"
            ;;
        bash)
            INSTRUCTION_TARGET=""
            return
            ;;
    esac

    # Copy template to workspace if target doesn't exist
    if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]] && [[ ! -f "$WORKSPACE_DIR/$target" ]]; then
        render_instruction_template "$WORKSPACE_DIR/$target"
    fi

    INSTRUCTION_TARGET="$target"
}

strip_command_frontmatter() {
    local source_path="$1"

    awk '
        NR == 1 && $0 == "---" { in_frontmatter=1; next }
        in_frontmatter && $0 == "---" { in_frontmatter=0; next }
        !in_frontmatter { print }
    ' "$source_path"
}

render_codex_skill() {
    local skill_name="$1"
    local description="$2"
    local source_path="$3"
    local target_path="$4"
    local temp_path="${target_path}.tmp"

    {
        printf -- '---\n'
        printf 'name: "%s"\n' "$skill_name"
        printf 'description: "%s"\n' "$description"
        printf -- '---\n\n'
        printf '<!-- Generated by agentic-researcher. Edit commands/%s.md to change this skill. -->\n\n' "$skill_name"
        printf 'This project skill mirrors the `%s` research command.\n\n' "$skill_name"
        printf 'If the user supplied extra text alongside this skill invocation, treat that text as the command argument.\n\n'
        strip_command_frontmatter "$source_path" \
            | sed 's/\$ARGUMENTS/any extra user text that accompanied the skill invocation/g'
    } > "$temp_path"

    mv "$temp_path" "$target_path"
}

setup_codex_project_skills() {
    CODEX_PROJECT_SKILLS_DIR="$WORKSPACE_DIR/.agents/skills"
    mkdir -p "$CODEX_PROJECT_SKILLS_DIR"

    local managed_marker="Generated by agentic-researcher"
    local skill_name description source_path skill_dir target_path

    while IFS='|' read -r skill_name description; do
        source_path="$SCRIPT_DIR/commands/$skill_name.md"
        if [[ ! -f "$source_path" ]]; then
            continue
        fi

        skill_dir="$CODEX_PROJECT_SKILLS_DIR/$skill_name"
        target_path="$skill_dir/SKILL.md"

        if [[ -f "$target_path" ]] && ! grep -q "$managed_marker" "$target_path"; then
            echo "Warning: Skipping existing Codex skill at $target_path (not managed by agentic-researcher)"
            continue
        fi

        mkdir -p "$skill_dir"
        render_codex_skill "$skill_name" "$description" "$source_path" "$target_path"
    done << 'EOF'
setup_research_plan|Set up or resume a research project in this workspace
retro|Reflect on the current research session and propose instruction improvements
update_base|Update the project instruction file from the latest base template
EOF
}

stage_research_assets() {
    [[ "$AR_CLI_TOOL" == "bash" ]] && return

    local cmd_file

    # The instruction template is staged into the store home for the
    # update_base command, regardless of tool.
    if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
        render_instruction_template "$STORE_HOME/.claude/INSTRUCTIONS.md.template"
    fi

    case "$AR_CLI_TOOL" in
        claude)
            for cmd_file in setup_research_plan retro update_base; do
                if [[ -f "$SCRIPT_DIR/commands/$cmd_file.md" ]]; then
                    cp "$SCRIPT_DIR/commands/$cmd_file.md" "$STORE_HOME/.claude/commands/$cmd_file.md"
                fi
            done
            ;;
        opencode)
            for cmd_file in setup_research_plan retro update_base; do
                if [[ -f "$SCRIPT_DIR/commands/$cmd_file.md" ]]; then
                    cp "$SCRIPT_DIR/commands/$cmd_file.md" "$STORE_HOME/.config/opencode/commands/$cmd_file.md"
                fi
            done
            ;;
        codex|pi)
            # Both Codex and pi auto-discover project skills under .agents/skills/.
            setup_codex_project_skills
            ;;
    esac
}

# Resolve a config template: a user copy in the config dir takes precedence
# over the repo default. Returns empty if neither exists.
resolve_template() {
    local name="$1"
    local user_template="${XDG_CONFIG_HOME:-$HOME/.config}/agentic-researcher/$name"
    if [[ -f "$user_template" ]]; then
        printf '%s\n' "$user_template"
    elif [[ -f "$SCRIPT_DIR/config/$name" ]]; then
        printf '%s\n' "$SCRIPT_DIR/config/$name"
    fi
}

# Render static endpoint configs for tools that need a config file to use an
# OpenAI-compatible endpoint (opencode, pi). Active when AR_CUSTOM_ENDPOINT
# is set; both configs are rendered regardless of the selected tool so they
# never go stale when switching tools or endpoints. The API key is NOT
# written to disk - templates reference the AR_CUSTOM_API_KEY env var.
# Marker files track launcher-rendered configs so they can be removed when
# the endpoint is unset, without ever touching user-authored configs.
render_managed_templates() {
    local oc_config="$STORE_HOME/.config/opencode/opencode.json"
    local oc_marker="$STORE_HOME/.config/opencode/.opencode.json.ar-managed"
    local pi_config="$STORE_HOME/.pi/agent/models.json"
    local pi_marker="$STORE_HOME/.pi/agent/.models.json.ar-managed"

    if [[ -z "${AR_CUSTOM_ENDPOINT:-}" ]]; then
        # Endpoint unset: remove previously rendered configs (marker present)
        # so a stale custom provider doesn't linger as the default.
        if [[ -f "$oc_marker" ]]; then
            rm -f "$oc_config" "$oc_marker"
        fi
        if [[ -f "$pi_marker" ]]; then
            rm -f "$pi_config" "$pi_marker"
        fi
        return 0
    fi

    local template model_id
    model_id="${AR_DEFAULT_MODEL:-default}"

    template="$(resolve_template opencode_config.template.json)"
    if [[ -n "$template" ]]; then
        sed -e "s|__AR_CUSTOM_ENDPOINT__|$AR_CUSTOM_ENDPOINT|g" \
            -e "s|__AR_DEFAULT_MODEL__|$model_id|g" \
            "$template" > "$oc_config"
        touch "$oc_marker"
    fi

    template="$(resolve_template pi_models.template.json)"
    if [[ -n "$template" ]]; then
        sed -e "s|__AR_CUSTOM_ENDPOINT__|$AR_CUSTOM_ENDPOINT|g" \
            -e "s|__AR_DEFAULT_MODEL__|$model_id|g" \
            "$template" > "$pi_config"
        touch "$pi_marker"
    fi
}

# ============================================================================
# Tool argument translation
# ============================================================================

translate_tool_args() {
    local tool="$AR_CLI_TOOL"

    case "$tool" in
        claude)
            if [[ "$MODEL_SPECIFIED" == "false" && -n "${AR_DEFAULT_MODEL:-}" ]]; then
                TOOL_ARGS+=("--model" "$AR_DEFAULT_MODEL")
            fi
            if [[ "$YOLO_MODE" == "true" ]]; then
                TOOL_ARGS+=("--dangerously-skip-permissions")
            fi
            ;;
        opencode)
            # Translate Claude-style flags to OpenCode equivalents
            local translated=()
            local skip_next=false
            for ((i=0; i<${#TOOL_ARGS[@]}; i++)); do
                if [[ "$skip_next" == "true" ]]; then
                    skip_next=false
                    continue
                fi
                local arg="${TOOL_ARGS[$i]}"
                case "$arg" in
                    --dangerously-skip-permissions)
                        echo "Warning: --yolo has no effect in OpenCode mode"
                        ;;
                    --resume)
                        local next="${TOOL_ARGS[$((i+1))]:-}"
                        if [[ -n "$next" && ! "$next" =~ ^- ]]; then
                            translated+=("--session" "$next")
                            skip_next=true
                        else
                            echo "Warning: --resume without ID not supported in OpenCode"
                        fi
                        ;;
                    --context)
                        skip_next=true
                        echo "Warning: --context not supported in OpenCode"
                        ;;
                    *)
                        translated+=("$arg")
                        ;;
                esac
            done
            TOOL_ARGS=(${translated[@]+"${translated[@]}"})
            if [[ "$MODEL_SPECIFIED" == "false" && -n "${AR_DEFAULT_MODEL:-}" ]]; then
                TOOL_ARGS+=("--model" "$AR_DEFAULT_MODEL")
            fi
            if [[ "$DEBUG_LAUNCH" == "true" ]]; then
                TOOL_ARGS+=("--print-logs" "--log-level" "DEBUG")
            fi
            if [[ "$YOLO_MODE" == "true" ]]; then
                echo "Warning: --yolo has no effect in OpenCode mode (no permission system)"
            fi
            ;;
        gemini|qwen)
            if [[ "$MODEL_SPECIFIED" == "false" && -n "${AR_DEFAULT_MODEL:-}" ]]; then
                TOOL_ARGS+=("--model" "$AR_DEFAULT_MODEL")
            fi
            if [[ " ${TOOL_ARGS[*]} " != *" --sandbox "* ]]; then
                TOOL_ARGS+=("--sandbox=false")
            fi
            if [[ "$DEBUG_LAUNCH" == "true" ]]; then
                TOOL_ARGS+=("--debug")
            fi
            if [[ "$YOLO_MODE" == "true" ]]; then
                TOOL_ARGS+=("--yolo")
            fi
            ;;
        codex)
            if [[ "$MODEL_SPECIFIED" == "false" && -n "${AR_DEFAULT_MODEL:-}" ]]; then
                TOOL_ARGS+=("--model" "$AR_DEFAULT_MODEL")
            fi
            if [[ "$YOLO_MODE" == "true" ]]; then
                TOOL_ARGS+=("--full-auto")
            fi
            ;;
        pi)
            # Translate Claude-style flags to pi equivalents
            local translated=()
            local skip_next=false
            for ((i=0; i<${#TOOL_ARGS[@]}; i++)); do
                if [[ "$skip_next" == "true" ]]; then
                    skip_next=false
                    continue
                fi
                local arg="${TOOL_ARGS[$i]}"
                case "$arg" in
                    --dangerously-skip-permissions)
                        echo "Warning: --yolo has no effect in pi mode (no permission system)"
                        ;;
                    --resume)
                        # pi: bare --resume opens an interactive picker; --resume ID maps to --session ID
                        local next="${TOOL_ARGS[$((i+1))]:-}"
                        if [[ -n "$next" && ! "$next" =~ ^- ]]; then
                            translated+=("--session" "$next")
                            skip_next=true
                        else
                            translated+=("--resume")
                        fi
                        ;;
                    --context)
                        skip_next=true
                        echo "Warning: --context not supported in pi"
                        ;;
                    *)
                        translated+=("$arg")
                        ;;
                esac
            done
            TOOL_ARGS=(${translated[@]+"${translated[@]}"})
            if [[ "$MODEL_SPECIFIED" == "false" && -n "${AR_DEFAULT_MODEL:-}" ]]; then
                TOOL_ARGS+=("--model" "$AR_DEFAULT_MODEL")
            fi
            if [[ "$DEBUG_LAUNCH" == "true" ]]; then
                TOOL_ARGS+=("--verbose")
            fi
            if [[ "$YOLO_MODE" == "true" ]]; then
                echo "Warning: --yolo has no effect in pi mode (no permission system)"
            fi
            ;;
        bash)
            ;;
    esac
}

# ============================================================================
# Container launch
# ============================================================================

gpu_active() {
    # GPU passthrough is currently Docker-only (parity with v1).
    [[ "$AR_CONTAINER_RUNTIME" == "docker" ]] || return 1
    case "${AR_DOCKER_GPUS:-auto}" in
        all)
            return 0
            ;;
        auto)
            [[ "$(uname -s)" == "Linux" ]] && command -v nvidia-smi >/dev/null 2>&1
            return $?
            ;;
        none|*)
            return 1
            ;;
    esac
}

resolve_image() {
    if [[ -n "${AR_IMAGE:-}" ]]; then
        printf '%s\n' "$AR_IMAGE"
    elif gpu_active; then
        printf '%s\n' "${AR_GPU_IMAGE:-$DEFAULT_GPU_IMAGE}"
    else
        printf '%s\n' "$DEFAULT_IMAGE"
    fi
}

build_env_args() {
    ENV_ARGS=(
        -e "AR_ENTRYPOINT=$AR_ENTRYPOINT"
        -e "AR_CLI_TOOL=$AR_CLI_TOOL"
        -e "HOME=$STORE_MOUNT/home"
        -e "USER=$USER"
        -e "PATH=$AR_TOOL_PATHS:$SYSTEM_PATHS"
        -e "AR_TOOL_PATHS=$AR_TOOL_PATHS"
        -e "NPM_CONFIG_CACHE=$STORE_MOUNT/npm-cache"
        -e "NPM_CONFIG_PREFIX=$STORE_MOUNT/npm-global"
        -e "npm_config_update_notifier=false"
        -e "npm_config_fund=false"
        -e "npm_config_audit=false"
        -e "UV_CACHE_DIR=$STORE_MOUNT/uv/cache"
        -e "UV_LINK_MODE=symlink"
        -e "JULIAUP_DEPOT_PATH=$STORE_MOUNT/julia"
        -e "HF_HOME=$STORE_MOUNT/hf_home"
        -e "TRITON_CACHE_DIR=$STORE_MOUNT/triton_cache"
        -e "WANDB_DIR=$STORE_MOUNT/wandb"
        -e "TERM=${TERM:-xterm-256color}"
        -e "COLORTERM=${COLORTERM:-truecolor}"
        -e "TERM_PROGRAM=${TERM_PROGRAM:-}"
        -e "AR_UPDATE=${AR_UPDATE:-auto}"
        -e "AR_GPU=$GPU_FLAG_ACTIVE"
        -e "DISABLE_AUTOUPDATER=1"
    )

    if [[ -n "${AR_UPDATE_TTL:-}" ]]; then
        ENV_ARGS+=(-e "AR_UPDATE_TTL=$AR_UPDATE_TTL")
    fi
    if [[ -n "${AR_NO_COOLDOWN:-}" ]]; then
        ENV_ARGS+=(-e "AR_NO_COOLDOWN=$AR_NO_COOLDOWN")
    fi

    # Export the host terminal's terminfo so non-standard terminals (ghostty,
    # kitty, ...) render correctly inside the container.
    local terminfo_b64=""
    if command -v infocmp >/dev/null 2>&1 && infocmp "${TERM:-}" >/dev/null 2>&1; then
        terminfo_b64=$(infocmp "${TERM}" 2>/dev/null | base64 | tr -d '\n')
    fi
    if [[ -n "$terminfo_b64" ]]; then
        ENV_ARGS+=(-e "AR_TERMINFO_B64=$terminfo_b64")
    fi

    # Standard API key pass-through so CLIs can handle auth inside the container.
    local env_name
    for env_name in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY; do
        if [[ -n "${!env_name:-}" ]]; then
            ENV_ARGS+=(-e "${env_name}=${!env_name}")
        fi
    done

    # If AR_API_KEY_ENV names a non-standard var, forward it as ANTHROPIC_API_KEY.
    # Only in api-key mode - in oauth mode the CLI handles auth itself.
    if [[ "${AR_AUTH_MODE:-}" == "api-key" ]]; then
        local _ar_key_var="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
        if [[ "$_ar_key_var" != "ANTHROPIC_API_KEY" && -n "${!_ar_key_var:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
            ENV_ARGS+=(-e "ANTHROPIC_API_KEY=${!_ar_key_var}")
        fi
    fi

    # Claude: Anthropic-compatible custom endpoint (api-key mode only)
    if [[ "$AR_CLI_TOOL" == "claude" && -n "${AR_CUSTOM_ANTHROPIC_ENDPOINT:-}" && "${AR_AUTH_MODE:-}" == "api-key" ]]; then
        ENV_ARGS+=(-e "ANTHROPIC_BASE_URL=$AR_CUSTOM_ANTHROPIC_ENDPOINT")
    fi

    # Generic OpenAI-compatible endpoint: passed to the container for codex
    # config generation; the key travels as AR_CUSTOM_API_KEY (referenced by
    # the opencode/pi templates and codex env_key - never written to disk).
    if [[ -n "${AR_CUSTOM_ENDPOINT:-}" ]]; then
        local _key_var="${AR_API_KEY_ENV:-}"
        local _key_val=""
        if [[ -n "$_key_var" ]]; then
            _key_val="${!_key_var:-}"
        fi
        ENV_ARGS+=(-e "AR_CUSTOM_ENDPOINT=$AR_CUSTOM_ENDPOINT")
        # Non-empty fallback: pi hides providers whose apiKey resolves empty,
        # and some gateways accept any token.
        ENV_ARGS+=(-e "AR_CUSTOM_API_KEY=${_key_val:-unused}")
        if [[ -z "$_key_val" ]]; then
            echo "Note: AR_CUSTOM_ENDPOINT is set but \$${_key_var:-AR_API_KEY_ENV} is empty;" >&2
            echo "      passing placeholder key 'unused' (fine for keyless gateways)." >&2
        fi
    fi

    # Proxy
    if [[ -n "${AR_HTTPS_PROXY:-}" ]]; then
        ENV_ARGS+=(-e "https_proxy=$AR_HTTPS_PROXY" -e "http_proxy=${AR_HTTP_PROXY:-$AR_HTTPS_PROXY}")
    elif [[ -n "${HTTPS_PROXY:-}" ]]; then
        ENV_ARGS+=(-e "https_proxy=$HTTPS_PROXY" -e "http_proxy=${HTTP_PROXY:-$HTTPS_PROXY}")
    fi

    # Extra user-defined environment variables (pipe-separated KEY=VALUE pairs)
    if [[ -n "${AR_EXTRA_ENV:-}" ]]; then
        local IFS='|'
        local entry
        for entry in $AR_EXTRA_ENV; do
            [[ -n "$entry" ]] && ENV_ARGS+=(-e "$entry")
        done
    fi

    # Host uid/gid for the in-container privilege drop (Docker on Linux only;
    # rootless Podman maps the user via --userns keep-id, macOS Docker Desktop
    # handles ownership itself, --unsafe intentionally stays root).
    if [[ "$AR_CONTAINER_RUNTIME" == "docker" && "$(uname -s)" == "Linux" && "${AR_UNSAFE:-0}" != "1" ]]; then
        ENV_ARGS+=(-e "AR_UID=$(id -u)" -e "AR_GID=$(id -g)")
    fi
}

print_debug_launch() {
    if [[ "$DEBUG_LAUNCH" != "true" ]]; then
        return
    fi

    echo "Launch debug:"
    echo "  Runtime:        $AR_CONTAINER_RUNTIME"
    echo "  Tool:           $AR_CLI_TOOL"
    echo "  Image:          $CONTAINER_IMAGE"
    echo "  Workspace:      $WORKSPACE_DIR"
    echo "  State root:     $STATE_ROOT"
    echo "  Container:      $CONTAINER_NAME"
    echo "  Tool args:      ${TOOL_ARGS[*]:-(none)}"
    if [[ -n "${AR_EXTRA_ENV:-}" ]]; then
        echo "  Extra env:      $AR_EXTRA_ENV"
    fi
    echo ""
}

launch_container() {
    local mode="${1:-run}"

    GPU_FLAG_ACTIVE=0
    if gpu_active; then
        GPU_FLAG_ACTIVE=1
    fi
    if [[ "${AR_DOCKER_GPUS:-auto}" == "all" && "$AR_CONTAINER_RUNTIME" != "docker" ]]; then
        echo "Warning: GPU passthrough is currently Docker-only; launching without GPUs."
    fi

    CONTAINER_IMAGE="$(resolve_image)"
    CONTAINER_NAME="agentic-researcher-${AR_ENTRYPOINT}-$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' ')"

    build_env_args
    print_debug_launch

    local RUN_ARGS=(
        "$AR_CONTAINER_RUNTIME" run --rm --init
        --name "$CONTAINER_NAME"
        -v "$WORKSPACE_DIR:/workspace:rw"
        -w /workspace
        -v "$STATE_ROOT:$STORE_MOUNT:rw"
        -v "$SCRIPT_DIR/container/inner.sh:/ar-entrypoint.sh:ro"
    )

    if [[ -t 0 && -t 1 ]]; then
        RUN_ARGS+=(-it)
    fi

    if [[ "$AR_CONTAINER_RUNTIME" == "podman" ]]; then
        RUN_ARGS+=(--userns keep-id)
    fi

    if [[ "$mode" == "test" ]]; then
        RUN_ARGS+=(-v "$SCRIPT_DIR/scripts/test_sandbox.sh:/test_sandbox.sh:ro")
    fi

    # Security hardening: drop all capabilities, then add back the minimum.
    #   DAC_OVERRIDE/FOWNER - root must handle host-owned files on bind mounts
    #   SETUID/SETGID       - setpriv privilege drop to the host user
    #   CHOWN               - only in GPU/unsafe mode (apt-get/dpkg need it)
    RUN_ARGS+=(
        --cap-drop=ALL
        --cap-add=DAC_OVERRIDE
        --cap-add=FOWNER
        --cap-add=SETUID
        --cap-add=SETGID
        --security-opt no-new-privileges
    )

    local lockdown="${AR_LOCKDOWN:-0}"
    if [[ "$GPU_FLAG_ACTIVE" == "1" ]]; then
        RUN_ARGS+=(--cap-add=CHOWN --gpus all)
        lockdown=0
    fi
    if [[ "${AR_UNSAFE:-0}" == "1" ]]; then
        RUN_ARGS+=(--cap-add=CHOWN)
        lockdown=0
    fi
    if [[ "$lockdown" == "1" ]]; then
        RUN_ARGS+=(--read-only --tmpfs /tmp --pids-limit=256)
    fi

    RUN_ARGS+=(${ENV_ARGS[@]+"${ENV_ARGS[@]}"})
    RUN_ARGS+=("$CONTAINER_IMAGE" bash -l /ar-entrypoint.sh)
    RUN_ARGS+=(${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"})

    local rc=0
    "${RUN_ARGS[@]}" || rc=$?

    # Restore the terminal: some TUIs enable the kitty keyboard protocol and
    # may not clean up on exit; stty sane resets traditional tty settings.
    printf '\e[=0u\e[<10u' 2>/dev/null || true
    stty sane 2>/dev/null || true

    if [[ "$rc" -ne 0 ]]; then
        echo "[agentic-researcher] Exited with code ${rc}" >&2
    fi
    return "$rc"
}

# ============================================================================
# Auxiliary modes
# ============================================================================

shell_into_container() {
    local target="$SHELL_TARGET"
    local containers
    containers=$("$AR_CONTAINER_RUNTIME" ps --filter "name=agentic-researcher-" --format '{{.Names}}' 2>/dev/null || true)

    if [[ -z "$containers" ]]; then
        echo "No running agentic-researcher containers found."
        exit 1
    fi

    if [[ -z "$target" ]]; then
        local count
        count=$(echo "$containers" | wc -l | tr -d ' ')
        if [[ "$count" -eq 1 ]]; then
            target="$containers"
        else
            echo "Running agentic-researcher containers:"
            local name workspace
            while IFS= read -r name; do
                workspace=$("$AR_CONTAINER_RUNTIME" inspect "$name" --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || true)
                printf "  %-48s %s\n" "$name" "${workspace:-unknown}"
            done <<< "$containers"
            echo ""
            echo "Usage: agentic-researcher --shell <container-name>"
            exit 0
        fi
    fi

    if ! echo "$containers" | grep -q "^${target}$"; then
        echo "Error: Container not found or not running: $target"
        exit 1
    fi

    exec "$AR_CONTAINER_RUNTIME" exec -it "$target" bash
}

redact() {
    if [[ -n "$1" ]]; then
        echo "***set***"
    else
        echo "(unset)"
    fi
}

print_env_summary() {
    GPU_FLAG_ACTIVE=0
    if gpu_active; then
        GPU_FLAG_ACTIVE=1
    fi
    local key_var="${AR_API_KEY_ENV:-}"
    local key_val=""
    if [[ -n "$key_var" ]]; then
        key_val="${!key_var:-}"
    fi

    echo "Resolved configuration:"
    echo "  AR_CONTAINER_RUNTIME=$AR_CONTAINER_RUNTIME"
    echo "  AR_CLI_TOOL=$AR_CLI_TOOL"
    echo "  AR_DEFAULT_MODEL=${AR_DEFAULT_MODEL:-}"
    echo "  AR_STATE_ROOT=${AR_STATE_ROOT}"
    echo "  AR_IMAGE=$(resolve_image)"
    echo "  AR_DOCKER_GPUS=${AR_DOCKER_GPUS} (active: $GPU_FLAG_ACTIVE)"
    echo "  AR_AUTH_MODE=${AR_AUTH_MODE:-}"
    echo "  AR_API_KEY_ENV=${AR_API_KEY_ENV:-} [$(redact "$key_val")]"
    echo "  AR_CUSTOM_ENDPOINT=${AR_CUSTOM_ENDPOINT:-}"
    echo "  AR_CUSTOM_ANTHROPIC_ENDPOINT=${AR_CUSTOM_ANTHROPIC_ENDPOINT:-}"
    echo "  AR_UPDATE=${AR_UPDATE:-auto} (TTL: ${AR_UPDATE_TTL:-21600}s)"
    echo "  AR_NO_COOLDOWN=${AR_NO_COOLDOWN:-}"
    echo "  AR_UNSAFE=${AR_UNSAFE:-0}  AR_LOCKDOWN=${AR_LOCKDOWN:-0}  AR_EPHEMERAL=${AR_EPHEMERAL:-0}"
    echo "  AR_HTTPS_PROXY=${AR_HTTPS_PROXY:-}"
    echo "  AR_EXTRA_ENV=${AR_EXTRA_ENV:-}"
    echo ""
    echo "Standard key pass-through:"
    echo "  ANTHROPIC_API_KEY=$(redact "${ANTHROPIC_API_KEY:-}")"
    echo "  OPENAI_API_KEY=$(redact "${OPENAI_API_KEY:-}")"
    echo "  GOOGLE_API_KEY=$(redact "${GOOGLE_API_KEY:-}")"
    echo "  GEMINI_API_KEY=$(redact "${GEMINI_API_KEY:-}")"
}

# ============================================================================
# Main
# ============================================================================

main() {
    check_install_staleness
    capture_env_overrides
    parse_arguments "$@"
    load_config
    apply_env_overrides
    apply_defaults

    case "$AR_CLI_TOOL" in
        claude|opencode|gemini|codex|qwen|pi|bash) ;;
        *)
            echo "Error: Unknown tool: $AR_CLI_TOOL (use claude|opencode|gemini|codex|qwen|pi|bash)"
            exit 1
            ;;
    esac
    AR_ENTRYPOINT="$AR_CLI_TOOL"

    if [[ "$PRINT_ENV_MODE" == "true" ]]; then
        print_env_summary
        exit 0
    fi

    if [[ "$SHELL_MODE" == "true" ]]; then
        validate_runtime
        shell_into_container
        # not reached
    fi

    validate_runtime

    if [[ "$PREWARM_MODE" == "true" ]]; then
        setup_storage
        # Use a private scratch dir as the workspace - prewarm should not
        # expose the caller's current directory to the container.
        WORKSPACE_DIR="$STATE_ROOT/.prewarm"
        mkdir -p "$WORKSPACE_DIR"
        AR_ENTRYPOINT="bash"
        TOOL_ARGS=(-c 'echo "[agentic-researcher] Store prewarmed."')
        echo "Prewarming the persistent store (image pull + tool installs)..."
        launch_container run
        exit $?
    fi

    validate_workspace
    validate_api_key
    setup_storage
    setup_instruction_file
    translate_tool_args
    stage_research_assets
    render_managed_templates

    # Display banner
    local tool_display
    case "$AR_CLI_TOOL" in
        claude)   tool_display="Claude Code" ;;
        opencode) tool_display="OpenCode" ;;
        gemini)   tool_display="Gemini CLI" ;;
        codex)    tool_display="Codex CLI" ;;
        qwen)     tool_display="Qwen Code" ;;
        pi)       tool_display="pi" ;;
        bash)     tool_display="Shell" ;;
        *)        tool_display="$AR_CLI_TOOL" ;;
    esac

    local banner_width=64
    echo "╔$(printf '═%.0s' $(seq 1 $banner_width))╗"
    local title="Agentic Researcher - $tool_display"
    local pad=$(( banner_width - ${#title} - 7 ))
    printf "║       %s%*s║\n" "$title" "$pad" ""
    echo "╚$(printf '═%.0s' $(seq 1 $banner_width))╝"
    echo ""

    echo "Workspace:      $WORKSPACE_DIR"
    echo "Sandboxed:      Only /workspace is accessible"
    echo "Store:          $STATE_ROOT$([[ "$EPHEMERAL_ACTIVE" == "true" ]] && echo ' (ephemeral)')"

    if [[ "$YOLO_MODE" == "true" ]]; then
        echo "Mode:           YOLO (auto-approve enabled)"
    else
        echo "Mode:           Protected (manual approval required)"
    fi
    echo ""

    if [[ "$TEST_MODE" == "true" ]]; then
        AR_ENTRYPOINT="bash"
        TOOL_ARGS=(/test_sandbox.sh)
        launch_container test
        exit $?
    fi

    echo "Starting $tool_display..."
    echo "================================================================"
    echo ""

    launch_container run
}

main "$@"
