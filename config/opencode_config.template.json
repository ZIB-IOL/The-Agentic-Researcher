{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom Provider",
      "options": {
        "baseURL": "__AR_CUSTOM_ENDPOINT__",
        "apiKey": "{env:AR_CUSTOM_API_KEY}"
      },
      "models": {
        "__AR_DEFAULT_MODEL__": {
          "name": "__AR_DEFAULT_MODEL__"
        }
      }
    }
  },
  "model": "custom/__AR_DEFAULT_MODEL__",
  "theme": "catppuccin"
}
